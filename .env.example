# Salin ke .env lalu isi nilai lokal. Jangan commit .env.

# Database (Prisma 7 membaca ini via prisma.config.ts)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/arah_indonesia"

# NextAuth — produksi wajib HTTPS publik, contoh: https://arahindonesia.org
NEXTAUTH_SECRET="ganti-dengan-secret-acak"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — callback: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP (opsional)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="MAI Portal <noreply@example.com>"
# ADMIN_EMAIL="admin@mai.id"
